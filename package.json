{
  "name": "flexpay-desktop-beauty",
  "version": "1.0.0",
  "private": true,
  "description": "FlexPay التجميل — نظام إدارة الصالونات ومحلات الحلاقة (خدمات بس)",
  "author": "FlexPay",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:next": "next dev",
    "dev:electron": "wait-on tcp:127.0.0.1:3000 && npm run build:electron && cross-env NODE_ENV=development node scripts/run-electron.js dist-electron/electron/main.js",
    "dev": "concurrently -k -n NEXT,ELEC -c blue,magenta \"npm:dev:next\" \"npm:dev:electron\"",
    "build:next": "next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:next && npm run build:electron",
    "start": "cross-env NODE_ENV=production node scripts/run-electron.js dist-electron/electron/main.js",
    "dist": "npm run build && electron-builder --config electron-builder.config.js",
    "smoke": "node scripts/run-electron.js scripts/smoke.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "next lint",
    "setup:native": "node scripts/setup-native.js",
    "postinstall": "node scripts/setup-native.js"
  },
  "dependencies": {
    "@types/jsbarcode": "^3.11.4",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "exceljs": "^4.4.0",
    "jsbarcode": "^3.12.3"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.468.0",
    "next": "15.1.3",
    "next-themes": "^0.4.4",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  }
}
